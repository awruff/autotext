{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Send a saved chat message or command with one key press.",
  "authors": [
    "Polyfrost", "anolithme"
  ],
  "license": "AGPL-3.0-or-later",
  "icon": "assets/autotext/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "org.polyfrost.autotext.AutoTextEntrypoint"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version_range}",
    "oneconfigv1": ">=${oneconfig_version}",
    "fabric-language-kotlin": "*"
  }
}
